---
import ProjectCard from "@/astro/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/site";
import { t } from "@/i18n/index";

const locale = "fr";
const i = t(locale);
---

<BaseLayout title="Projets" description="Études de cas sélectionnées de Chames Dhibi sur les produits numériques, les plateformes de services et les outils interactifs." locale={locale}>
  <main class="pb-16">
    <section class="page-shell relative overflow-hidden py-12 md:py-20">
      <p class="section-word pointer-events-none absolute left-0 top-14 text-[5rem] sm:text-[8rem] md:text-[13rem]">{i.work.eyebrow}</p>
      <div class="relative z-10 max-w-5xl">
        <p class="eyebrow">{i.work.eyebrow}</p>
        <h1 class="display-monument mt-5 text-[4.3rem] text-white sm:text-[5.4rem] md:text-[7.4rem]">
          {i.work.h1Start}
          <span class="editorial-outline ml-2 inline-block">{i.work.h1Outline}</span>
          .
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-white/62">{i.work.body}</p>
      </div>
    </section>

    <section class="section-line overflow-hidden">
      <div class="page-shell py-16 md:py-20">
        <div class="grid gap-6 lg:grid-cols-12" data-reveal-stagger>
          {
            projects.map((project, index) => {
              const layouts = [
                "lg:col-span-7",
                "lg:col-span-5 lg:pt-10",
                "lg:col-span-6",
                "lg:col-span-6 lg:pt-10",
                "lg:col-span-5",
                "lg:col-span-7 lg:pt-10",
              ];
              return <ProjectCard project={project} compact className={layouts[index % layouts.length]} locale={locale} />;
            })
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
