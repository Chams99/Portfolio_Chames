---
import CountUp from "@/astro/CountUp.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { avatarImage, projectImages } from "@/data/generatedImages";
import { capabilities, contactChannels, isExternalHref, projects, siteConfig } from "@/data/site";
import { t } from "@/i18n/index";

const locale = "fr";
const i = t(locale);
const visibleProjects = projects.slice(0, 6);

const stacks = [
  {
    name: "Next.js",
    category: "Frontend",
    desc: "Applications web full-stack, pages d'accueil et produits SSR avec React et TypeScript.",
    related: ["TypeScript", "Tailwind CSS", "Vercel"],
    iconPath: "M18.665 21.978C16.758 23.255 14.465 24 12 24 5.377 24 0 18.623 0 12S5.377 0 12 0s12 5.377 12 12c0 3.583-1.574 6.801-4.067 9.001L9.219 7.2H7.2v9.596h1.615V9.251l9.85 12.727Zm-3.332-8.533 1.6 2.061V7.2h-1.6v6.245Z",
  },
  {
    name: "Flutter",
    category: "Mobile",
    desc: "Applications iOS & Android cross-platform depuis une seule base de code Dart.",
    related: ["Dart", "Firebase", "REST APIs"],
    iconPath: "M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z",
  },
  {
    name: "Node.js",
    category: "Backend",
    desc: "APIs REST, systèmes temps réel et architecture serveur fiable.",
    related: ["Elysia", "Express", "Supabase"],
    iconPath: "M11.998 24c-.321 0-.641-.084-.922-.247l-2.936-1.737c-.438-.245-.224-.332-.08-.383.585-.203.703-.25 1.328-.604.065-.037.151-.023.218.017l2.256 1.339c.082.045.197.045.272 0l8.795-5.076c.082-.047.134-.141.134-.238V6.921c0-.099-.053-.192-.137-.242l-8.791-5.072c-.081-.047-.189-.047-.271 0L3.075 6.68C2.99 6.729 2.936 6.825 2.936 6.921v10.15c0 .097.054.189.139.235l2.409 1.392c1.307.654 2.108-.116 2.108-.89V7.787c0-.142.114-.253.256-.253h1.115c.139 0 .255.112.255.253v10.021c0 1.745-.95 2.745-2.604 2.745-.508 0-.909 0-2.026-.551L2.28 18.675c-.57-.329-.922-.945-.922-1.604V6.921c0-.659.353-1.275.922-1.603l8.795-5.082c.557-.315 1.296-.315 1.848 0l8.794 5.082c.57.329.924.944.924 1.603v10.15c0 .659-.354 1.273-.924 1.604l-8.794 5.078C12.643 23.916 12.324 24 11.998 24zm7.101-10.007c0-1.9-1.284-2.406-3.987-2.763-2.731-.361-3.009-.548-3.009-1.187 0-.528.235-1.233 2.258-1.233 1.807 0 2.473.389 2.747 1.607.024.115.129.199.247.199h1.141c.071 0 .138-.031.186-.081.048-.054.074-.123.067-.196-.177-2.098-1.571-3.076-4.388-3.076-2.508 0-4.004 1.058-4.004 2.833 0 1.925 1.488 2.457 3.895 2.695 2.88.282 3.103.703 3.103 1.269 0 .983-.789 1.402-2.642 1.402-2.327 0-2.839-.584-3.011-1.742-.02-.124-.126-.215-.253-.215h-1.137c-.141 0-.254.112-.254.253 0 1.482.806 3.248 4.655 3.248 2.786.001 4.384-1.096 4.384-3.013z",
  },
  {
    name: "React",
    category: "UI",
    desc: "Interfaces composants, SPA et applications web interactives.",
    related: ["Vite", "TypeScript", "TailwindCSS"],
    iconPath: "M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38a2.167 2.167 0 0 0-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.345-.034-.46 0-.915.01-1.36.034.44-.572.895-1.096 1.345-1.565zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.098 2.21-.098zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.386zm7.26 0c.695.103 1.365.23 2.006.387-.18.632-.405 1.282-.66 1.933-.2-.39-.41-.783-.64-1.174-.225-.392-.465-.774-.705-1.146zm3.063.675c.484.15.944.317 1.375.498 1.732.74 2.852 1.708 2.852 2.476-.005.768-1.125 1.74-2.857 2.475-.42.18-.88.342-1.355.493-.28-.958-.646-1.956-1.1-2.98.45-1.017.81-2.01 1.085-2.964zm-13.395.004c.278.96.645 1.957 1.1 2.98-.45 1.017-.812 2.01-1.086 2.964-.484-.15-.944-.318-1.37-.5-1.732-.737-2.852-1.706-2.852-2.474 0-.768 1.12-1.742 2.852-2.476.42-.18.88-.342 1.356-.494zm11.678 4.28c.265.657.49 1.312.676 1.948-.64.157-1.316.29-2.016.39.24-.375.48-.762.705-1.158.225-.39.435-.788.636-1.18zm-9.945.02c.2.392.41.783.64 1.175.23.39.465.772.705 1.143-.695-.102-1.365-.23-2.006-.386.18-.63.406-1.282.66-1.933zM17.92 16.32c.112.493.2.968.254 1.423.23 1.868-.054 3.32-.714 3.708-.147.09-.338.128-.563.128-1.012 0-2.514-.807-4.11-2.28.686-.72 1.37-1.536 2.02-2.44 1.107-.118 2.154-.3 3.113-.54zm-11.83.01c.96.234 2.006.415 3.107.532.66.905 1.345 1.727 2.035 2.446-1.595 1.483-3.092 2.295-4.11 2.295-.22-.005-.406-.05-.553-.132-.666-.38-.955-1.834-.73-3.703.054-.46.142-.944.25-1.438zm4.56.64c.44.02.89.034 1.345.034.46 0 .915-.01 1.36-.034-.44.572-.895 1.095-1.345 1.565-.455-.47-.91-.993-1.36-1.565z",
  },
];
---

<BaseLayout title="Dhibi Chames Eddine | Développeur Full-Stack Web & Mobile" locale={locale}>
  <main id="top" class="pb-16">

    <!-- ═══ HERO ═══ -->
    <section class="relative overflow-hidden tmpl-section-padding">
      <div class="ambient-grid pointer-events-none absolute inset-x-0 top-0 h-[34rem]"></div>

      <div class="page-shell relative z-10">
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">

          <!-- Left: text -->
          <div>
            <p class="eyebrow" data-reveal>{i.home.eyebrow}</p>

            <div class="mt-6" data-reveal>
              <h1 class="tmpl-hero-title-pill text-[1.65rem] font-bold text-white">Bonjour, je suis Chames!</h1>
            </div>

            <div class="mt-4" data-reveal>
              <h2 class="tmpl-hero-title-pill text-[1.2rem] font-semibold text-white">
                {i.home.h1Line1} des apps web, mobile &amp; IA.
              </h2>
            </div>

            <div class="mt-8 flex flex-wrap gap-2" data-reveal>
              {["Next.js", "Flutter", "Node.js", "React", "Supabase", "TypeScript"].map((t) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/55 backdrop-blur-sm">
                  {t}
                </span>
              ))}
            </div>

            <div class="mt-8 flex flex-col gap-4 sm:flex-row" data-reveal>
              <a
                href="#selected-work"
                class="premium-button inline-flex items-center gap-2 rounded-full px-6 py-4 text-sm uppercase tracking-[0.22em] text-white transition-transform hover:-translate-y-0.5"
              >
                {i.home.cta}
              </a>
              <a
                href="#contact"
                class="secondary-button inline-flex items-center gap-2 rounded-full px-6 py-4 text-sm uppercase tracking-[0.22em] text-white transition-transform hover:-translate-y-0.5"
              >
                {i.home.ctaSecondary}
              </a>
            </div>

            <div class="mt-10 flex gap-8 border-t border-white/8 pt-8" data-reveal>
              <div>
                <p class="text-2xl font-bold text-white">15+</p>
                <p class="text-xs uppercase tracking-wider text-white/45">Projets livrés</p>
              </div>
              <div>
                <p class="text-2xl font-bold text-white">3+</p>
                <p class="text-xs uppercase tracking-wider text-white/45">Années d'expérience</p>
              </div>
              <div>
                <p class="text-2xl font-bold text-white">5+</p>
                <p class="text-xs uppercase tracking-wider text-white/45">Produits en ligne</p>
              </div>
            </div>
          </div>

          <!-- Right: floating portrait (desktop) -->
          <div class="relative hidden lg:block" style="height: 480px;">
            <div class="tmpl-hero-image-wrap"></div>
            <img
              src={avatarImage.src}
              class="tmpl-hero-portrait"
              alt="Chames Dhibi"
              loading="eager"
              fetchpriority="high"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ ABOUT ═══ -->
    <section class="section-line tmpl-section-padding" id="about">
      <div class="page-shell">
        <div class="grid items-center gap-10 lg:grid-cols-2">

          <!-- Left: portrait -->
          <div data-reveal="fade-left">
            <img
              src={avatarImage.src}
              alt="Chames Eddine Dhibi"
              class="w-full rounded-3xl object-cover object-top"
              style="aspect-ratio: 4/3;"
              loading="lazy"
            />
          </div>

          <!-- Right: story -->
          <div data-reveal>
            <div class="tmpl-section-title-wrap mb-6">
              <span class="tmpl-badge-dot"></span>
              <h2 class="font-bold text-white">Mon Histoire</h2>
            </div>

            <h3 class="mb-4 mt-5 text-2xl font-bold text-white">Un peu sur Chames Eddine</h3>

            <p class="mb-4 text-base leading-7 text-white/62">
              Je suis développeur full-stack web et mobile de Gafsa, Tunisie. Je crée des produits avec
              Next.js, Flutter, Node.js et l'IA. Je m'attache à une architecture propre, une exécution
              fiable et des résultats qui semblent intentionnels dès la première interaction.
            </p>
            <p class="text-base leading-7 text-white/62">
              Du lancement de produits et plateformes web aux applications mobiles et systèmes backend,
              je rassemble toute la stack — pour que le résultat final ne soit pas seulement conçu,
              mais entièrement construit et prêt à livrer.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ PROFILE + STATS ═══ -->
    <section class="tmpl-section-bg tmpl-section-padding">
      <div class="page-shell">
        <div class="grid gap-8 lg:grid-cols-2">

          <!-- Profile card -->
          <div class="tmpl-profile-thumb" data-reveal="fade-left">
            <div class="tmpl-profile-title">
              <h4 class="m-0 text-lg font-bold text-white">Informations</h4>
            </div>
            <div class="tmpl-profile-body">
              <p>
                <span class="tmpl-profile-small-title">Nom</span>
                <span class="flex-1 px-4 py-3 text-sm text-white/70">Dhibi Chames Eddine</span>
              </p>
              <p>
                <span class="tmpl-profile-small-title">Base</span>
                <span class="flex-1 px-4 py-3 text-sm text-white/70">Gafsa, Tunisie</span>
              </p>
              <p>
                <span class="tmpl-profile-small-title">Stack</span>
                <span class="flex-1 px-4 py-3 text-sm text-white/70">Next.js · Flutter · Node.js</span>
              </p>
              <p>
                <span class="tmpl-profile-small-title">Email</span>
                <span class="flex-1 px-4 py-3 text-sm text-white/70">
                  <a href={`mailto:${siteConfig.email}`} class="transition-colors hover:text-white">
                    {siteConfig.email}
                  </a>
                </span>
              </p>
            </div>
          </div>

          <!-- Stats 2×2 -->
          <div data-reveal>
            <div class="grid h-full grid-cols-2">
              <div class="tmpl-featured-border-bottom py-6 pr-6">
                <div class="tmpl-featured-numbers"><CountUp target={15} suffix="+" /></div>
                <span class="tmpl-featured-text">Projets Livrés</span>
              </div>
              <div class="tmpl-featured-border-bottom tmpl-featured-border-start py-6 pl-6">
                <div class="tmpl-featured-numbers"><CountUp target={3} suffix="+" /></div>
                <span class="tmpl-featured-text">Années d'Expérience</span>
              </div>
              <div class="pt-6 pr-6">
                <div class="tmpl-featured-numbers"><CountUp target={5} suffix="+" /></div>
                <span class="tmpl-featured-text">Produits en Ligne</span>
              </div>
              <div class="tmpl-featured-border-start pt-6 pl-6">
                <div class="tmpl-featured-numbers">3</div>
                <span class="tmpl-featured-text">Frameworks Principaux</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ STACK ═══ -->
    <section class="section-line tmpl-section-padding" id="capabilities">
      <div class="page-shell">

        <div class="flex justify-center" data-reveal>
          <div class="tmpl-section-title-wrap">
            <span class="tmpl-badge-dot"></span>
            <h2 class="font-bold text-white">Stack</h2>
          </div>
        </div>

        <div class="mt-8 grid gap-6 pt-4 lg:grid-cols-2" data-reveal-stagger>
          {
            stacks.map((stack, i_) => (
              <div
                data-reveal
                class={`tmpl-services-thumb${i_ % 2 === 1 ? " tmpl-services-thumb-up" : ""}`}
              >
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3">
                  <h3 class="m-0 text-xl font-bold text-white">{stack.name}</h3>
                  <div class="tmpl-price-wrap">
                    <p class="tmpl-price-text">{stack.category}</p>
                  </div>
                </div>
                <p class="mb-5 text-base leading-7 text-white/62">{stack.desc}</p>
                <div class="flex flex-wrap gap-2">
                  {stack.related.map((tag) => (
                    <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-white/50">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="tmpl-services-icon-wrap">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="tmpl-services-icon-svg">
                    <path d={stack.iconPath} />
                  </svg>
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ═══ PROJECTS ═══ -->
    <section class="tmpl-section-bg tmpl-section-padding" id="selected-work">
      <div class="page-shell">

        <div class="flex justify-end" data-reveal>
          <div class="tmpl-section-title-wrap">
            <span class="tmpl-badge-dot"></span>
            <h2 class="font-bold text-white">Projets</h2>
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
          {
            visibleProjects.map((project) => {
              const img = projectImages[project.slug]?.card.src ?? project.heroImage;
              return (
                <a href={`/fr/work/${project.slug}`} class="block" data-reveal>
                  <div class="tmpl-projects-thumb m-3">
                    <span class="tmpl-projects-tag">{project.category}</span>
                    <h3 class="tmpl-projects-title">{project.title}</h3>
                    <img
                      src={img}
                      alt={project.title}
                      class="tmpl-projects-image"
                      loading="lazy"
                    />
                  </div>
                </a>
              );
            })
          }
        </div>

        <div class="mt-12 text-center" data-reveal>
          <a
            href="/fr/work"
            class="secondary-button inline-flex items-center gap-2 rounded-full px-8 py-4 text-sm uppercase tracking-[0.22em] text-white transition-transform hover:-translate-y-0.5"
          >
            Voir tous les projets →
          </a>
        </div>

      </div>
    </section>

    <!-- ═══ CONTACT ═══ -->
    <section class="section-line tmpl-section-padding" id="contact">
      <div class="page-shell">

        <div class="mb-10" data-reveal>
          <div class="tmpl-section-title-wrap">
            <span class="tmpl-badge-dot"></span>
            <h2 class="font-bold text-white">Dites Bonjour</h2>
          </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-[1fr_1fr_2fr]">

          <!-- Services + socials -->
          <div class="tmpl-contact-info" data-reveal="fade-left">
            <strong class="tmpl-footer-section-title">Services</strong>
            <ul class="tmpl-footer-menu">
              {
                i.capabilities.items.map((cap) => (
                  <li>
                    <a href="#" class="tmpl-footer-menu-link">
                      {cap.title}
                    </a>
                  </li>
                ))
              }
            </ul>

            <strong class="tmpl-footer-section-title mt-6 block">Rester connecté</strong>
            <ul class="tmpl-social-icon">
              {
                contactChannels.map((ch) => (
                  <li>
                    <a
                      href={ch.href}
                      target={isExternalHref(ch.href) ? "_blank" : undefined}
                      rel={isExternalHref(ch.href) ? "noreferrer" : undefined}
                      class="tmpl-social-icon-link"
                      aria-label={ch.label}
                      title={ch.label}
                    >
                      {ch.label.slice(0, 2)}
                    </a>
                  </li>
                ))
              }
            </ul>

            <strong class="tmpl-footer-section-title mt-6 block">Démarrer un projet</strong>
            <p class="mt-2 text-sm leading-6 text-white/62">
              Disponible pour des projets freelance et collaborations.
            </p>
          </div>

          <!-- About + contact details -->
          <div class="tmpl-contact-info" data-reveal>
            <strong class="tmpl-footer-section-title">À propos</strong>
            <p class="mb-0 mt-3 text-sm leading-6 text-white/62">
              Développeur full-stack de Gafsa, Tunisie. N'hésitez pas à me contacter.
            </p>

            <strong class="tmpl-footer-section-title mt-6 block">Email</strong>
            <p class="mb-0 mt-2">
              <a
                href={`mailto:${siteConfig.email}`}
                class="text-sm text-white/70 transition-colors hover:text-white"
              >
                {siteConfig.email}
              </a>
            </p>

            <strong class="tmpl-footer-section-title mt-5 block">GitHub</strong>
            <p class="mb-0 mt-2">
              <a
                href="https://github.com/Chams99"
                target="_blank"
                rel="noreferrer"
                class="text-sm text-white/70 transition-colors hover:text-white"
              >
                github.com/Chams99
              </a>
            </p>

            <strong class="tmpl-footer-section-title mt-5 block">Upwork</strong>
            <p class="mb-0 mt-2">
              <a
                href="https://www.upwork.com/freelancers/~01ec2dc27e0c617399"
                target="_blank"
                rel="noreferrer"
                class="text-sm text-white/70 transition-colors hover:text-white"
              >
                upwork.com/freelancers
              </a>
            </p>
          </div>

          <!-- CTA card with channel pills -->
          <div class="mt-4 lg:mt-0" data-reveal>
            <div
              class="atmospheric-card panel-gradient relative h-full overflow-hidden rounded-2xl px-6 py-10"
            >
              <div class="relative z-10">
                <p class="eyebrow">{i.cta.eyebrow}</p>
                <h3 class="display-monument mt-4 text-3xl text-white">
                  {i.cta.title}
                </h3>
                <p class="mt-4 text-sm leading-7 text-white/62">
                  {i.cta.body}
                </p>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="mt-6 inline-flex items-center gap-2 rounded-full border border-[color:var(--primary)]/20 px-6 py-4 text-sm uppercase tracking-[0.22em] text-white transition-transform hover:-translate-y-0.5"
                >
                  {i.cta.button}
                </a>
              </div>

              <div class="relative z-10 mt-8 grid gap-3 sm:grid-cols-2">
                {
                  contactChannels.slice(0, 4).map((channel) => (
                    <a
                      href={channel.href}
                      target={isExternalHref(channel.href) ? "_blank" : undefined}
                      rel={isExternalHref(channel.href) ? "noreferrer" : undefined}
                      class="tint-card group rounded-2xl px-4 py-3 transition-transform hover:-translate-y-0.5"
                    >
                      <p class="eyebrow text-[color:var(--primary)]">{channel.label}</p>
                      <p class="mt-1 break-words text-xs leading-5 text-white/74 group-hover:text-white">
                        {channel.value}
                      </p>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</BaseLayout>
