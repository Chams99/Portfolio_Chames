---
import ResponsiveImage from "@/astro/ResponsiveImage.astro";
import ExperienceStack from "@/astro/ExperienceStack.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { avatarImage } from "@/data/generatedImages";
import { t } from "@/i18n/index";

const locale = "fr";
const i = t(locale);
---

<BaseLayout title="À propos" description="À propos de Dhibi Chames Eddine, développeur full-stack web et mobile." locale={locale}>
  <main class="pb-16">
    <section class="page-shell relative overflow-hidden py-12 md:py-20">
      <p class="section-word pointer-events-none absolute left-0 top-12 text-[5rem] sm:text-[7rem] md:text-[12rem]">About</p>
      <div class="relative z-10 grid gap-12 lg:grid-cols-[1.06fr_0.94fr]">
        <div>
          <p class="eyebrow" data-reveal>{i.about.eyebrow}</p>
          <h1 class="display-monument mt-5 text-[4.3rem] text-white sm:text-[5.4rem] md:text-[7rem]" data-reveal>
            {i.about.h1Start}
            <span class="editorial-outline ml-2 inline-block">{i.about.h1Outline}</span>
            ,
            <br />
            {i.about.h1End}
          </h1>
          <div class="mt-8 grid gap-5 text-base leading-7 text-white/62" data-reveal>
            <p>{i.about.body1}</p>
            <p>{i.about.body2}</p>
          </div>
        </div>

        <div class="grid gap-4 lg:grid-rows-[auto_1fr_auto]">
          <div class="ml-auto max-w-sm rounded-[1.75rem] border border-white/10 bg-white/[0.03] px-5 py-4 backdrop-blur-sm">
            <p class="eyebrow text-white/70">{i.about.currentDirection}</p>
            <p class="mt-2 text-sm leading-6 text-white/86">{i.about.currentDirectionBody}</p>
          </div>

          <div class="relative mx-auto w-full max-w-[31rem]">
            <div class="image-frame relative aspect-[4/5] overflow-hidden rounded-[2.6rem]">
              <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
              <ResponsiveImage
                src={avatarImage}
                alt="Portrait de Chames Dhibi"
                class="h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
                sizes="(min-width: 1024px) 31rem, 80vw"
              />
            </div>
          </div>

          <div class="max-w-sm rounded-[1.75rem] border border-white/10 bg-white/[0.03] px-5 py-4 backdrop-blur-sm">
            <p class="eyebrow text-[color:var(--primary)]">{i.about.whatMatters}</p>
            <p class="mt-2 text-sm leading-6 text-white/82">{i.about.whatMattersBody}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-line overflow-hidden">
      <div class="page-shell relative py-16 md:py-20">
        <p class="section-word pointer-events-none absolute right-0 top-10 text-[5rem] sm:text-[7rem] md:text-[11rem]">Values</p>
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
          <div><p class="eyebrow">{i.about.principlesLabel}</p></div>
          <div class="grid gap-5 md:grid-cols-3" data-reveal-stagger>
            {
              i.principles.map((item, index) => (
                <article data-reveal class={`atmospheric-card p-7 ${index === 1 ? "md:translate-y-12" : ""}`}>
                  <h2 class="text-2xl text-white">{item.title}</h2>
                  <p class="mt-4 text-sm leading-6 text-white/62">{item.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section-line overflow-hidden">
      <div class="page-shell relative py-16 md:py-20">
        <p class="section-word pointer-events-none absolute left-0 top-10 text-[5rem] sm:text-[7rem] md:text-[11rem]">Path</p>
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
          <div><p class="eyebrow">{i.about.experienceLabel}</p></div>
          <ExperienceStack items={i.experience} />
        </div>
      </div>
    </section>

    <section class="section-line overflow-hidden">
      <div class="page-shell relative py-16 md:py-20">
        <p class="section-word pointer-events-none absolute right-0 top-16 text-[5rem] sm:text-[7rem] md:text-[10rem]">Process</p>
        <div class="max-w-3xl">
          <p class="eyebrow">{i.about.processEyebrow}</p>
          <h2 class="display-monument mt-4 text-[3.8rem] text-white sm:text-[4.8rem] md:text-[6rem]">
            {i.about.processTitle}
            <span class="editorial-outline ml-2 inline-block">{i.about.processOutline}</span>
          </h2>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal-stagger>
          {
            i.processSteps.map((step, index) => (
              <article data-reveal class={`atmospheric-card panel-gradient p-7 ${index % 2 === 1 ? "md:translate-y-10" : ""}`}>
                <p class="eyebrow text-[color:var(--primary)]">{step.label}</p>
                <h3 class="mt-4 text-2xl text-white">{step.title}</h3>
                <p class="mt-3 text-sm leading-6 text-white/62">{step.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
