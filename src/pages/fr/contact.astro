---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contactChannels, isExternalHref, siteConfig } from "@/data/site";
import { t } from "@/i18n/index";

const locale = "fr";
const i = t(locale);
---

<BaseLayout title="Contact" description="Contactez Dhibi Chames Eddine pour apps web, Flutter, produits backend et développement full-stack." locale={locale}>
  <main class="pb-16">
    <section class="page-shell relative overflow-hidden pt-24 pb-12 md:pt-32 md:pb-20">
      <p class="section-word pointer-events-none absolute left-0 top-20 text-[4.5rem] sm:text-[6.5rem] md:text-[10rem] lg:text-[11rem]">Contact</p>
      <div class="relative z-10 max-w-5xl">
        <p class="eyebrow" data-reveal>{i.contact.eyebrow}</p>
        <h1 class="display-monument mt-5 max-w-[13ch] text-[3.8rem] text-white sm:text-[4.8rem] md:text-[5.9rem] lg:text-[6.8rem]" data-reveal>
          {i.contact.h1Start}
          <span class="editorial-outline ml-2 inline-block">{i.contact.h1Outline}</span>
          {i.contact.h1End}
        </h1>
        <p class="mt-8 max-w-2xl text-base leading-7 text-white/62" data-reveal>
          {i.contact.body}
        </p>
      </div>
    </section>

    <section class="section-line overflow-hidden">
      <div class="page-shell grid gap-10 py-16 md:py-20 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-5">
          <p class="eyebrow">{i.contact.bestFit}</p>
          <h2 class="editorial-title text-5xl text-white md:text-6xl">{i.contact.bestFitTitle}</h2>
          <p class="max-w-xl text-sm leading-6 text-white/62">
            {i.contact.bestFitBody}
          </p>

          <div class="atmospheric-card panel-gradient max-w-md p-6">
            <p class="eyebrow">{i.contact.primaryContact}</p>
            <a href={`mailto:${siteConfig.email}`} class="mt-3 inline-flex min-w-0 max-w-full items-center gap-3 text-xl text-white transition-colors hover:text-[color:var(--primary)]">
              <span class="[overflow-wrap:anywhere]">{siteConfig.email}</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2" data-reveal-stagger>
          {
            contactChannels.map((item, index) => (
              <a
                data-reveal
                href={item.href}
                target={isExternalHref(item.href) ? "_blank" : undefined}
                rel={isExternalHref(item.href) ? "noreferrer" : undefined}
                class={`atmospheric-card panel-gradient flex min-h-48 flex-col justify-between p-6 hover:bg-white/[0.06] ${
                  index % 2 === 1 ? "md:translate-y-10" : ""
                }`}
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="eyebrow text-white/70">{item.label}</p>
                  <span class="text-white/55">↗</span>
                </div>
                <p class="text-lg leading-7 text-white [overflow-wrap:anywhere]">{item.value}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
