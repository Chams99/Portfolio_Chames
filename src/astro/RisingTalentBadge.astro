---
interface Props {
  label?: string;
}

const { label = "Rising Talent" } = Astro.props;
---

<span class="rising-talent-badge">
  <span class="rising-talent-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="m12 2.75 2.15 5.08 5.47.45-4.16 3.58 1.25 5.35L12 14.34l-4.71 2.87 1.25-5.35L4.38 8.28l5.47-.45L12 2.75Z" />
      <circle cx="12" cy="11.3" r="1.45" />
    </svg>
  </span>
  <span class="rising-talent-copy">
    <strong>{label}</strong>
  </span>
</span>
