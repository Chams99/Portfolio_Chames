---
interface Props {
  label?: string;
}

const { label = "Rising Talent" } = Astro.props;
---

<span class="rising-talent-badge">
  <span class="rising-talent-mark" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28" focusable="false" role="img">
      <path fill="#14A800" d="M12 1.155a4 4 0 0 1 4 0l8.124 4.69a4 4 0 0 1 2 3.464v9.382a4 4 0 0 1-2 3.464L16 26.845a4 4 0 0 1-4 0l-8.124-4.69a4 4 0 0 1-2-3.464V9.309a4 4 0 0 1 2-3.464L12 1.155Z" />
      <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1.5" d="M13.65 20V8m5.17 4.985L13.65 8l-4.984 4.985" />
    </svg>
  </span>
  <span class="rising-talent-copy">
    <strong>{label}</strong>
  </span>
</span>
