---
import type { Project } from "@/data/site";
import { isExternalHref } from "@/data/site";

interface Props {
  project: Project;
  compact?: boolean;
  className?: string;
}

const { project, compact = false, className = "" } = Astro.props;
const scrollPreview = compact && project.previewMode === "scroll";
const cardTags = (project.stack?.length ? project.stack : project.roles).slice(0, compact ? 3 : 2);
const projectHref = project.externalLink ?? `/work/${project.slug}`;
const external = project.externalLink ? isExternalHref(project.externalLink) : false;
---

<a href={projectHref} class={`group block min-w-0 ${className}`} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
  <article class="atmospheric-card panel-gradient glow-accent flex h-full min-w-0 flex-col overflow-hidden transition-transform duration-500 group-hover:-translate-y-1">
    <div class={`relative overflow-hidden bg-black/20 ${compact ? (scrollPreview ? "aspect-[4/3]" : "aspect-[16/10]") : "aspect-[5/4]"}`}>
      {
        scrollPreview ? (
          <div data-simplebar data-simplebar-auto-hide="false" class="scroll-card-scroll h-full bg-[#120f14]">
            <img src={project.heroImage} alt={project.title} class="h-auto w-full object-top" loading="lazy" />
          </div>
        ) : (
          <img
            src={project.heroImage}
            alt={project.title}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        )
      }
      <div class={`pointer-events-none absolute inset-0 ${scrollPreview ? "bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-70" : "bg-gradient-to-t from-black/60 via-black/5 to-transparent opacity-90"}`}></div>
      <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/8"></div>
      <p class="absolute left-5 top-5 rounded-full border border-white/12 bg-black/35 px-3 py-1 text-[0.62rem] uppercase tracking-[0.28em] text-white/80 backdrop-blur-sm">
        {project.category}
      </p>
      {
        scrollPreview ? (
          <p class="pointer-events-none absolute bottom-4 right-4 rounded-full border border-white/10 bg-black/45 px-3 py-1 text-[0.6rem] uppercase tracking-[0.24em] text-white/70 backdrop-blur-sm">
            Scroll
          </p>
        ) : null
      }
    </div>

    <div class={`flex flex-1 flex-col ${compact ? "gap-4 p-5" : "gap-5 p-6"}`}>
      <div class="flex items-center justify-between gap-4">
        <p class="eyebrow text-white/70">{project.year}</p>
        <span class="text-sm text-white/55 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white">
          &#8599;
        </span>
      </div>

      <div class="min-w-0">
        <h3 class={`editorial-title text-white ${compact ? "text-[2.2rem] md:text-[2.8rem]" : "text-3xl md:text-4xl"}`}>
          {project.title}
        </h3>
        {!compact && <p class="mt-4 text-sm leading-7 text-white/62">{project.summary}</p>}
      </div>

      {
        compact && cardTags.length ? (
          <div class="mt-auto flex flex-wrap gap-2">
            {cardTags.map((tag) => (
              <span class="rounded-full border border-white/10 px-3 py-1 text-[0.62rem] uppercase tracking-[0.2em] text-white/55">
                {tag}
              </span>
            ))}
          </div>
        ) : null
      }

      {!compact && (
        <div class="mt-auto flex flex-wrap gap-2">
          {cardTags.map((role) => (
            <span class="rounded-full border border-white/10 px-3 py-1 text-[0.7rem] uppercase tracking-[0.24em] text-white/55">
              {role}
            </span>
          ))}
        </div>
      )}
    </div>
  </article>
</a>
