---
import ResponsiveImage from "@/astro/ResponsiveImage.astro";
import type { Project } from "@/data/site";
import { getProjectImages } from "@/data/generatedImages";
import { getProjectCopy, type Locale } from "@/i18n/index";

interface Props {
  project: Project;
  compact?: boolean;
  className?: string;
  priority?: boolean;
  locale?: string;
}

const { project, compact = false, className = "", priority = false } = Astro.props;
const localeValue: Locale = Astro.props.locale === "fr" ? "fr" : "en";
const copy = getProjectCopy(localeValue, project);
const cardTags = copy.roles.slice(0, compact ? 3 : 2);
const projectHref = project.externalLink!;
const isExternal = projectHref.startsWith("http");
const media = getProjectImages(project.slug);
const previewImage = media?.card ?? project.heroImage;
const srcset = media
  ? compact
    ? `${media.card.src} ${media.card.width}w`
    : `${media.card.src} ${media.card.width}w, ${media.hero.src} ${media.hero.width}w`
  : undefined;
const imageLoading = priority ? "eager" : "lazy";
const imageFetchPriority = priority ? "high" : "auto";
const imageSizes = compact
  ? "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
  : "(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw";
---

<a href={projectHref} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined} class={`group block min-w-0 ${className}`}>
  <article class="project-card flex h-full min-w-0 flex-col overflow-hidden transition-transform duration-500 group-hover:-translate-y-1">
    <div class={`project-card-media relative overflow-hidden bg-[color:var(--card)] ${compact ? "aspect-[16/10]" : "aspect-[5/4]"}`}>
      <ResponsiveImage
        src={previewImage}
        alt={copy.alt}
        class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
        loading={imageLoading}
        fetchpriority={imageFetchPriority}
        sizes={imageSizes}
        srcset={srcset}
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/42 via-black/5 to-transparent opacity-75"></div>
      <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/8"></div>
      <p class="category-pill absolute left-5 top-5 rounded-full px-3 py-1 text-[0.62rem] uppercase tracking-normal text-white">
        {copy.category}
      </p>
    </div>

    <div class={`flex flex-1 flex-col ${compact ? "gap-4 p-5" : "gap-5 p-6"}`}>
      <div class="flex items-center justify-between gap-4">
        <p class="eyebrow text-white/70">{project.year}</p>
        <span class="project-arrow text-sm text-white/55 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white">
          &#8599;
        </span>
      </div>

      <div class="min-w-0">
        <h3 class={`editorial-title text-white ${compact ? "text-[1.9rem] md:text-[2.25rem]" : "text-3xl md:text-4xl"}`}>
          {project.title}
        </h3>
        <p class={`${compact ? "mt-3 text-sm leading-6 text-white/58" : "mt-4 text-sm leading-7 text-white/62"}`}>{copy.summary}</p>
      </div>

      {
        compact && cardTags.length ? (
          <div class="mt-auto flex flex-wrap gap-2">
            {cardTags.map((tag) => (
              <span class="project-tag rounded-full px-3 py-1 text-[0.62rem] uppercase tracking-normal">
                {tag}
              </span>
            ))}
          </div>
        ) : null
      }

      {!compact && (
        <div class="mt-auto flex flex-wrap gap-2">
          {cardTags.map((role) => (
            <span class="project-tag rounded-full px-3 py-1 text-[0.7rem] uppercase tracking-normal">
              {role}
            </span>
          ))}
        </div>
      )}
    </div>
  </article>
</a>
