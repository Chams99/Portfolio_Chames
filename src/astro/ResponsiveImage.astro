---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type LoadingValue = "eager" | "lazy";
type DecodingValue = "sync" | "async" | "auto";
type FetchPriorityValue = "high" | "low" | "auto";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  loading?: LoadingValue;
  decoding?: DecodingValue;
  fetchpriority?: FetchPriorityValue;
  widths?: number[];
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  decoding = "async",
  fetchpriority = "auto",
  widths,
  sizes,
  quality = 75,
} = Astro.props;

const isLocalAsset = typeof src !== "string";
---

{
  isLocalAsset ? (
    <Image
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={quality}
    />
  ) : (
    <img src={src} alt={alt} class={className} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />
  )
}
