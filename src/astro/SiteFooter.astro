---
import HelloMarquee from "@/astro/HelloMarquee.astro";
import { contactChannels, isExternalHref, siteConfig } from "@/data/site";
import { t, getLocaleFromUrl, localizedPath } from "@/i18n/index";

interface Props {
  locale?: string;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;
const i = t(locale);
const navLabels = [i.nav.home, i.nav.about, i.nav.work, i.nav.contact];
const scrollNavItems = [
  { href: localizedPath("/", locale as any) + "#top", label: navLabels[0] },
  { href: localizedPath("/", locale as any) + "#about", label: navLabels[1] },
  { href: localizedPath("/", locale as any) + "#selected-work", label: navLabels[2] },
  { href: localizedPath("/", locale as any) + "#contact", label: navLabels[3] },
];
---

<footer class="section-line mt-24">
  <HelloMarquee />
  <div class="page-shell py-14">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.9fr_0.9fr]">
      <div class="space-y-4">
        <p class="eyebrow">{i.footer.closingNote}</p>
        <h2 class="editorial-title max-w-xl text-4xl text-white md:text-6xl">
          {i.footer.closingTitle}
        </h2>
        <p class="max-w-lg text-sm leading-6 text-white/62">
          {i.footer.closingBody}
        </p>
      </div>

      <div class="space-y-3">
        <p class="eyebrow">{i.footer.navigate}</p>
        <div class="flex flex-col gap-2">
          {scrollNavItems.map((item) => (
            <a href={item.href} class="link-underline w-fit text-sm text-white/62 hover:text-white">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div class="space-y-3">
        <p class="eyebrow">{i.footer.connect}</p>
        <div class="flex flex-col gap-2">
          {contactChannels.map((item) => (
            <a
              href={item.href}
              target={isExternalHref(item.href) ? "_blank" : undefined}
              rel={isExternalHref(item.href) ? "noreferrer" : undefined}
              class="link-underline w-fit text-sm text-white/62 hover:text-white"
            >
              {item.label}: {item.value}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/8 pt-5 text-sm text-white/62">
      {i.footer.copyright} {new Date().getFullYear()} {siteConfig.name}
    </div>
  </div>
</footer>
