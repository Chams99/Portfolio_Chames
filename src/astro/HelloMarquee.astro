---
const texts = ["Hello", "Hola", "Hallo", "Bonjour", "Ciao", "مرحبا"];
const sequence = texts.join(" • ");
---

<div class="border-y border-white/8 py-4">
  <div class="marquee">
    <div class="marquee-track font-display text-[2.6rem] leading-none tracking-[-0.03em] text-white/90 md:text-[4rem]">
      <span class="marquee-copy">{sequence}</span>
      <span class="marquee-copy" aria-hidden="true">{sequence}</span>
    </div>
  </div>
</div>
