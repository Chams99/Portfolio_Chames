---
const texts = ["Hello", "Hola", "Hallo", "Bonjour", "Ciao", "مرحبا"];
const sequence = texts.join("  •  ");
---

<div class="page-shell py-8">
  <div class="greeting-band" aria-label={sequence}>
    <p class="font-display text-[2rem] leading-none text-white/90 md:text-[3rem]">
      {texts.join("  •  ")}
    </p>
  </div>
</div>
