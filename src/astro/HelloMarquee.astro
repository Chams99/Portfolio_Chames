---
const texts = ["Hello", "Hola", "Hallo", "Bonjour", "Ciao", "مرحبا"];
const sequence = texts.join("  •  ");
---

<div class="page-shell py-8">
  <div class="marquee-pill-band">
    <div class="marquee-pill-fader">
      <div class="marquee">
        <div class="marquee-track font-display text-[2.4rem] leading-none tracking-[-0.03em] text-white/90 md:text-[3.6rem]">
          <span class="marquee-copy">{sequence}</span>
          <span class="marquee-copy" aria-hidden="true">{sequence}</span>
        </div>
      </div>
    </div>
  </div>
</div>
