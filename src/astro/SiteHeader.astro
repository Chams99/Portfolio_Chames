---
import { siteConfig } from "@/data/site";
import { t } from "@/i18n/index";

interface Props {
  pathname: string;
  locale?: string;
}

const { pathname, locale = "en" } = Astro.props;
const i = t(locale);
const altLocale = locale === "fr" ? "en" : "fr";
const altLabel = locale === "fr" ? "EN" : "FR";

const navLabels = [i.nav.home, i.nav.stack, i.nav.projects, i.nav.experiences, i.nav.contact];
const scrollNavItems = [
  { href: "#top", label: navLabels[0] },
  { href: "#stack", label: navLabels[1] },
  { href: "#projects", label: navLabels[2] },
  { href: "#experiences", label: navLabels[3] },
  { href: "#contact", label: navLabels[4] },
];

function localizedHref(href: string) {
  if (locale === "en") return href;
  return `/fr${href === "/" ? "" : href}`;
}

function switchLocalePath() {
  if (locale === "en") {
    return `/fr${pathname === "/" ? "" : pathname}`;
  }
  return pathname.replace(/^\/fr/, "") || "/";
}
---

<div class="sticky top-0 z-40 border-b border-white/8 bg-black/72 backdrop-blur-xl">
  <header class="page-shell">
    <nav class="flex items-center justify-between gap-4 py-5" aria-label="Main navigation">
      <a href={localizedHref("/")} class="group flex items-center gap-3">
        <span class="brand-mark" aria-hidden="true">DCE</span>
        <span>
          <span class="eyebrow block text-white/75 transition-colors group-hover:text-white">{siteConfig.name}</span>
          <span class="block text-sm text-white/62">{i.header.subtitle}</span>
        </span>
      </a>

      <div class="relative hidden items-center gap-5 md:flex" id="desktop-nav">
        {
          scrollNavItems.map((item) => {
            const href = pathname === "/" ? item.href : `${localizedHref("/")}${item.href}`;
            const section = item.href.replace("#", "");
            return (
              <a
                href={href}
                data-section={section}
                class="nav-link relative z-10 text-sm text-white/62 transition-colors hover:text-white"
              >
                {item.label}
              </a>
            );
          })
        }
        <a href={switchLocalePath()} class="lang-switch">{altLabel}</a>
        <span
          id="nav-indicator"
          class="pointer-events-none absolute bottom-0 left-0 h-[2px] rounded-full bg-[color:var(--primary)] opacity-0 shadow-[0_0_10px_rgba(201,164,83,0.6)] transition-all duration-300 ease-out"
          aria-hidden="true"
        />
      </div>

      <!-- Mobile hamburger -->
      <div class="flex items-center gap-3 md:hidden">
        <a href={switchLocalePath()} class="lang-switch">{altLabel}</a>
        <button
          type="button"
          class="hamburger flex flex-col gap-[5px] p-2 text-white/62"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-btn"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu md:hidden" id="mobile-menu">
      <div class="flex flex-col gap-3 pb-6">
        {
          scrollNavItems.map((item) => {
            const href = pathname === "/" ? item.href : `${localizedHref("/")}${item.href}`;
            return (
              <a
                href={href}
                class="text-sm text-white/62 hover:text-white"
              >
                {item.label}
              </a>
            );
          })
        }
      </div>
    </div>
  </header>
</div>

<script>
  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    function setOpen(open) {
      btn.classList.toggle("active", open);
      menu.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
    }

    btn.addEventListener("click", () => {
      setOpen(!menu.classList.contains("open"));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }

  function initNavIndicator() {
    const nav = document.getElementById("desktop-nav");
    const indicator = document.getElementById("nav-indicator");
    if (!nav || !indicator) return;

    const links = nav.querySelectorAll('a[data-section]');
    if (!links.length) return;

    function moveIndicatorTo(section) {
      const target = nav.querySelector(`a[data-section="${section}"]`);
      if (!target) {
        indicator.style.opacity = "0";
        return;
      }
      indicator.style.opacity = "1";
      indicator.style.transform = `translateX(${target.offsetLeft}px)`;
      indicator.style.width = `${target.offsetWidth}px`;
    }

    function setActiveFromPath() {
      const path = window.location.pathname;
      if (path.includes("/work")) return moveIndicatorTo("projects");
      if (path.includes("/contact")) return moveIndicatorTo("contact");
      return null;
    }

    // Static pages (work / contact)
    if (setActiveFromPath()) return;

    // Homepage: track sections on scroll
    const sectionIds = ["top", "stack", "projects", "experiences", "contact"];
    const offset = 120;
    let current = "top";
    let ticking = false;

    function updateActiveSection() {
      const scrollPos = window.scrollY + offset;
      let active = "top";
      for (const id of sectionIds) {
        const section = document.getElementById(id);
        if (section && section.offsetTop <= scrollPos) {
          active = id;
        }
      }
      if (active !== current) {
        current = active;
        moveIndicatorTo(current);
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveSection();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => moveIndicatorTo(current));

    // Initial position after layout settles
    updateActiveSection();
  }

  initMobileMenu();
  initNavIndicator();
  document.addEventListener("astro:after-swap", () => {
    initMobileMenu();
    initNavIndicator();
  });
</script>
