---
// Zellige tessellation — the eight-pointed khatim of North African tilework.
// Drawn as ONE continuous 16-vertex outline (8 tips at the outer radius, 8
// valleys at the inner radius). Overlaying two closed squares instead would
// leave a visible square inside the star, which is not the motif.

interface Props {
  class?: string;
  tile?: number;
}

const { class: className = "", tile = 132 } = Astro.props;

// Unique per instance so multiple patterns on one page don't collide.
const uid = `zellige-${crypto.randomUUID().slice(0, 8)}`;

const c = tile / 2;
const outer = tile * 0.34;
// Where the two implied squares' edges cross: 1 / (cos22.5 + sin22.5).
const inner = outer * 0.7654;

const star = Array.from({ length: 16 }, (_, i) => {
  const radius = i % 2 === 0 ? outer : inner;
  const angle = (Math.PI / 8) * i - Math.PI / 2;
  return `${(c + radius * Math.cos(angle)).toFixed(2)},${(c + radius * Math.sin(angle)).toFixed(2)}`;
}).join(" ");
---

<svg
  class={className}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <g id={`${uid}-star`}>
      <polygon points={star} fill="none" stroke="currentColor" stroke-width="1" />
    </g>

    <pattern id={uid} width={tile} height={tile} patternUnits="userSpaceOnUse">
      <use href={`#${uid}-star`} />
      <use href={`#${uid}-star`} x={-c} y={-c} />
      <use href={`#${uid}-star`} x={c} y={-c} />
      <use href={`#${uid}-star`} x={-c} y={c} />
      <use href={`#${uid}-star`} x={c} y={c} />
    </pattern>
  </defs>

  <rect width="100%" height="100%" fill={`url(#${uid})`} />
</svg>
