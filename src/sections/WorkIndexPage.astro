---
import ProjectCard from "@/astro/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/site";

const visibleProjects = projects.filter((p) => p.externalLink);
import { t, type Locale } from "@/i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const isFr = locale === "fr";

const title = isFr ? "Projets" : "Work";
const description = isFr
  ? "Études de cas sélectionnées de Chames Dhibi sur les produits numériques, les plateformes de services et les outils interactifs."
  : "Selected case studies from Chames Dhibi across digital products, service platforms, company websites, and interactive tools.";
---

<BaseLayout title={title} description={description} locale={locale}>
  <main class="pb-16">
    <!-- ═══ HERO ═══ -->
    <section class="page-shell relative overflow-hidden py-16 md:py-24">
      <div class="relative z-10 max-w-4xl" data-reveal>
        <div class="tmpl-section-title-wrap">
          <span class="tmpl-badge-dot"></span>
          <h2 class="font-bold text-white">{i.work.eyebrow}</h2>
        </div>
        <h1 class="display-monument mt-8 text-[3.6rem] text-white sm:text-[4.8rem] md:text-[6.2rem]">
          {i.work.h1Start}
          <span class="editorial-outline ml-2 inline-block">{i.work.h1Outline}</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-white/62">{i.work.body}</p>
      </div>
    </section>

    <!-- ═══ PROJECTS GRID ═══ -->
    <section class="section-line tmpl-section-padding">
      <div class="page-shell">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
          {visibleProjects.map((project) => <ProjectCard project={project} compact />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
