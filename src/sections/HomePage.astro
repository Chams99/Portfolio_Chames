---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResponsiveImage from "@/astro/ResponsiveImage.astro";
import RisingTalentBadge from "@/astro/RisingTalentBadge.astro";
import SectionMarker from "@/astro/SectionMarker.astro";
import { avatarImage, projectImages } from "@/data/generatedImages";
import { skillCategories } from "@/data/skills";
import { contactChannels, isExternalHref, projects } from "@/data/site";
import { getProjectCopy, localizedPath, t, type Locale } from "@/i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const home = i.home;
const isFr = locale === "fr";

const pageTitle = isFr ? "Ingénieur logiciel & développeur full-stack | Chames Eddine Dhibi" : undefined;
const pageDescription = isFr
  ? "Chames Eddine Dhibi est diplômé en génie logiciel et développe des produits logiciels, des applications d'IA et des systèmes orientés données."
  : undefined;

const sortProjectsByYear = (items: typeof projects) =>
  [...items].sort((a, b) => Number(a.year) - Number(b.year));
const orderedExternalProjects = sortProjectsByYear(projects.filter((project) => project.externalLink));
const selectedProjectSlugs = [
  "dent-dental-clinic",
  "ftball-ecommerce",
  "unit-converter",
  "fitlite-ai-fitness",
  "webgrade-analyzer",
  "sspace-star-map",
] as const;
const selectedProjects = selectedProjectSlugs.flatMap((slug) =>
  orderedExternalProjects.find((project) => project.slug === slug) ?? [],
);
const archiveProjects = orderedExternalProjects.filter(
  (project) => !selectedProjectSlugs.includes(project.slug),
);
const projectGroups = [
  {
    key: "products" as const,
    slugs: ["modern-estate-vision", "cleanfile-agency", "dent-dental-clinic", "property-investment"],
  },
  {
    key: "commerce" as const,
    slugs: ["photo-printing-order", "ecommerce-platform", "fitlite-ai-fitness", "ftball-ecommerce", "la-cuisine-restaurant"],
  },
  {
    key: "experiments" as const,
    slugs: ["lolchat-gaming", "speed-typer-game", "sspace-star-map", "unit-converter", "wallpaper-generator"],
  },
].map((group) => ({
  ...group,
  projects: sortProjectsByYear(group.slugs.flatMap((slug) => archiveProjects.find((project) => project.slug === slug) ?? [])),
}));
const contactCards = ["Email", "Phone", "LinkedIn"]
  .map((label) => contactChannels.find((channel) => channel.label === label))
  .filter((channel): channel is (typeof contactChannels)[number] => Boolean(channel));

const getContactLabel = (label: string) => {
  if (label === "Email") return home.contact.emailLabel;
  if (label === "Phone") return home.contact.phoneLabel;
  if (label === "GitHub") return home.contact.githubLabel;
  if (label === "LinkedIn") return home.contact.linkedinLabel;
  return home.contact.upworkLabel;
};

const sectionLink = (path: string) => localizedPath(path, locale);

const indexItems = [
  { href: "#projects", number: "01", label: i.nav.projects },
  { href: "#stack", number: "02", label: i.nav.stack },
  { href: "#experiences", number: "03", label: i.nav.experiences },
  { href: "#contact", number: "04", label: i.nav.contact },
];
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale}>
  <main id="top" class="home-page">
    <nav class="home-index-rail" aria-label={isFr ? "Index de la page" : "Page index"}>
      <p class="home-index-signature">CD / {new Date().getFullYear()}</p>
      <ol>
        {indexItems.map((item) => (
          <li>
            <a href={item.href}>
              <span>{item.number}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="home-index-location">GAFSA · TN</p>
    </nav>

    <section class="home-hero" aria-labelledby="home-title">
      <div class="page-shell home-hero-inner">
        <div class="home-hero-copy">
          <p class="home-eyebrow" data-reveal>{home.hero.eyebrow}</p>
          <h1 id="home-title" class="home-title">
            {home.hero.nameLine1}<br />
            <span class="home-outline-hover">{home.hero.nameLine2}</span>
          </h1>
          <p class="home-hero-role" data-reveal>{home.hero.subtitle}</p>
          <p class="home-hero-body" data-reveal>{home.hero.body}</p>

          <div class="home-hero-actions" data-reveal>
            <a href="#projects" class="home-button home-button-primary">{home.hero.ctaPrimary}</a>
            <a href="#contact" class="home-button home-button-secondary">{home.hero.ctaSecondary}</a>
          </div>

          <p class="home-location" data-reveal>
            <span class="home-location-dot" aria-hidden="true"></span>
            {home.hero.location}
          </p>

          <p class="home-hero-signature" data-reveal>CD / {new Date().getFullYear()} · GAFSA, TN</p>
        </div>

        <figure class="home-portrait" data-reveal="fade-right">
          <div class="home-portrait-frame">
            <img
              src={avatarImage.src}
              alt={isFr ? "Portrait de Chames Eddine Dhibi" : "Portrait of Chames Eddine Dhibi"}
              width={avatarImage.width}
              height={avatarImage.height}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption>{home.hero.subtitle}</figcaption>
        </figure>
      </div>

      <a href="#projects" class="home-scroll-cue" aria-label={isFr ? "Voir les projets sélectionnés" : "View selected projects"}>
        <span class="home-scroll-cue-mouse" aria-hidden="true">
          <span class="home-scroll-cue-wheel"></span>
        </span>
        <span class="home-scroll-cue-label">{isFr ? "DÉFILER" : "SCROLL"}</span>
      </a>
    </section>

    <section id="projects" class="home-section home-work-section" aria-labelledby="projects-title">
      <div class="page-shell">
        <div class="home-section-intro" data-reveal>
          <div>
            <SectionMarker icon="projects" label={home.projects.selectedLabel} reveal />
            <h2 id="projects-title" class="home-section-title">{home.projects.sectionTitle}</h2>
          </div>
          <p class="home-section-lede">{home.projects.intro}</p>
        </div>

        <div class="selected-projects" data-reveal-stagger>
          {
            selectedProjects.map((project, index) => {
              const copy = getProjectCopy(locale, project);
              const media = projectImages[project.slug]?.card ?? project.heroImage;
              const projectMedia = projectImages[project.slug];
              const srcset = projectMedia
                ? `${projectMedia.card.src} ${projectMedia.card.width}w, ${projectMedia.hero.src} ${projectMedia.hero.width}w`
                : undefined;

              return (
                <a
                  href={project.externalLink}
                  target="_blank"
                  rel="noreferrer"
                  class:list={[
                    "selected-project group",
                    index === 0 && "selected-project-featured",
                    index > 0 && "selected-project-supporting",
                  ]}
                  data-reveal
                >
                  <div class="selected-project-media">
                    <ResponsiveImage
                      src={media}
                      alt={copy.alt}
                      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                      sizes="(min-width: 1024px) 58vw, 100vw"
                      srcset={srcset}
                    />
                    {index === 0 ? (
                      <span class="selected-project-media-label">{home.projects.featuredLabel}</span>
                    ) : null}
                  </div>

                  <div class="selected-project-content">
                    <div class="selected-project-meta">
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <span>{copy.category} · {project.year}</span>
                    </div>
                    <h3 class="selected-project-title">{project.title}</h3>
                    <p class="selected-project-contribution">{copy.contribution}</p>
                    <p class="selected-project-summary">{copy.summary}</p>
                    <div class="selected-project-footer">
                      <div class="selected-project-tags">
                        {copy.roles.slice(0, 3).map((role) => <span>{role}</span>)}
                      </div>
                      <span class="selected-project-link">{home.projects.openProject} <span aria-hidden="true">↗</span></span>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>

        <a href={sectionLink("/work")} class="home-text-link" data-reveal>
          {home.projects.viewAll} <span aria-hidden="true">↗</span>
        </a>

        <div class="home-project-index" data-reveal>
          <div class="home-project-index-intro">
            <div>
              <SectionMarker icon="archive" label={home.projects.archiveLabel} reveal />
              <h3>{i.work.archiveTitle}</h3>
            </div>
            <p>{i.work.archiveBody}</p>
          </div>

          <div class="home-project-groups">
            {projectGroups.map((group, groupIndex) => (
              <section class="home-project-group" aria-labelledby={`home-project-group-${group.key}`}>
                <div class="home-project-group-heading">
                  <div>
                    <span>{String(groupIndex + 1).padStart(2, "0")}</span>
                    <h4 id={`home-project-group-${group.key}`}>{i.work.groups[group.key]}</h4>
                  </div>
                  <span>{group.projects.length}</span>
                </div>
                <ul>
                  {group.projects.map((project) => (
                    <li>
                      <a href={project.externalLink} target="_blank" rel="noreferrer">
                        <span>{project.title}</span>
                        <span>{project.category} · {project.year} <span aria-hidden="true">↗</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="stack" class="home-section home-capabilities-section" aria-labelledby="capabilities-title">
      <div class="page-shell">
        <div class="skills-section-heading" data-reveal>
          <SectionMarker icon="skills" label={home.stack.sectionTitle} reveal />
          <h2 id="capabilities-title" class="skills-section-title">
            <span>{home.stack.titleLine1}</span>
            <span class="skills-section-title-outline">{home.stack.titleLine2}</span>
          </h2>
          <p>{home.stack.intro}</p>
        </div>

        <div class="skills-index" data-reveal-stagger>
          {
            skillCategories.map((category, index) => (
              <article class="skills-index-row" data-reveal>
                <div class="skills-index-meta">
                  <span class="skills-index-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{home.stack.categoryLabels[category.id]}</h3>
                </div>
                <ul class="skills-index-list">
                  {category.items.map((skill) => (
                    <li>
                      <a
                        href={skill.url}
                        target="_blank"
                        rel="noreferrer"
                        class="skills-index-link"
                        aria-label={isFr ? `Visiter le site de ${skill.name}` : `Visit ${skill.name} website`}
                      >
                        <span class="skill-icon-frame" aria-hidden="true">
                          <img
                            src={skill.icon}
                            alt=""
                            class:list={["skill-icon", skill.invert && "skill-icon-invert"]}
                            loading="lazy"
                            width="26"
                            height="26"
                            decoding="async"
                          />
                        </span>
                        <span class="skill-name" translate="no">{skill.name}</span>
                        <span class="skill-arrow" aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="experiences" class="home-section home-experience-section" aria-labelledby="experience-title">
      <div class="page-shell">
        <div class="home-section-intro" data-reveal>
          <div>
            <SectionMarker icon="experience" label={i.experiences.eyebrow} reveal />
            <h2 id="experience-title" class="home-section-title">{i.experiences.h1Start} {i.experiences.h1Outline}</h2>
          </div>
          <p class="home-section-lede">{i.experiences.body}</p>
        </div>

        <div class="experience-columns" data-reveal-stagger>
          <section class="experience-track" aria-labelledby="experience-track-title">
            <div class="experience-track-heading">
              <span aria-hidden="true">//</span>
              <h3 id="experience-track-title">{i.experiences.experienceLabel}</h3>
            </div>
            <ol class="experience-list">
              {
                i.experiences.workItems.map((item, index) => (
                  <li class="experience-item" data-reveal>
                    <span class="experience-item-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <p class="experience-period">{item.period}</p>
                    <div>
                      <h4>{item.title}</h4>
                      <p class="experience-place">{item.place}</p>
                      <p class="experience-details">{item.details}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="experience-track" aria-labelledby="education-track-title">
            <div class="experience-track-heading">
              <span aria-hidden="true">//</span>
              <h3 id="education-track-title">{i.experiences.educationLabel}</h3>
            </div>
            <ol class="experience-list">
              {
                i.experiences.educationItems.map((item, index) => (
                  <li class="experience-item" data-reveal>
                    <span class="experience-item-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <p class="experience-period">{item.period}</p>
                    <div>
                      <h4>{item.title}</h4>
                      <p class="experience-place">{item.place}</p>
                      <p class="experience-details">{item.details}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </section>
        </div>

        <div id="credentials" class="experience-credentials" data-reveal>
          <div class="experience-credentials-heading">
            <div>
              <SectionMarker icon="credentials" label={i.experiences.credentialsTitle} />
              <h3>{i.experiences.credentialsTitle}</h3>
            </div>
            <p>{i.experiences.credentialsBody}</p>
          </div>

          <div class="experience-credentials-grid" data-reveal-stagger>
            {i.experiences.credentials.map((item, index) => (
              <article
                class:list={[
                  "experience-credential",
                  index === 0 && "experience-credential-featured",
                  (index === 3 || index === 5) && "experience-credential-wide",
                  index === 3 && "experience-credential-achievement",
                ]}
                data-reveal
              >
                <span class="experience-credential-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <p class="experience-credential-label">{item.label}</p>
                <p class="experience-credential-value">{item.value}</p>
                {item.badge ? <RisingTalentBadge label={item.badge} /> : null}
                {item.href ? (
                  <a class="experience-credential-proof" href={item.href} target="_blank" rel="noreferrer">
                    {isFr ? "Vérifier sur Upwork" : "Verify on Upwork"} <span aria-hidden="true">↗</span>
                  </a>
                ) : null}
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="home-section home-contact-section" aria-labelledby="contact-title">
      <div class="page-shell">
        <div class="home-contact-card home-contact-compact" data-reveal>
          <div class="home-contact-copy">
            <SectionMarker
              icon="contact"
              label={`${home.contact.titleLine1} ${home.contact.titleLine2}`}
              class="home-contact-kicker"
            />
            <h2 id="contact-title" class="home-contact-title">
              <span>{home.contact.titleLine1}</span>
              <span class="home-contact-title-outline">{home.contact.titleLine2}</span>
            </h2>
            <p>{home.contact.body}</p>
          </div>
          <ul class="contact-channel-grid contact-channel-list" aria-label={isFr ? "Moyens de contact" : "Contact channels"}>
            {contactCards.map((channel) => {
              const external = isExternalHref(channel.href);
              const label = getContactLabel(channel.label);
              const value = channel.label === "Email" || channel.label === "Phone" ? channel.value : home.contact.profileAction;

              return (
                <li>
                  <a
                    href={channel.href}
                    class="contact-channel-card"
                    target={external ? "_blank" : undefined}
                    rel={external ? "noreferrer" : undefined}
                    aria-label={`${label}: ${value}`}
                  >
                    <span class:list={["contact-channel-icon", channel.label === "Upwork" && "contact-channel-icon-upwork"]} aria-hidden="true">
                      {channel.label === "Email" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <rect x="3.25" y="5.5" width="17.5" height="13" rx="1.5" />
                          <path d="m4 7 8 6 8-6" />
                        </svg>
                      ) : channel.label === "Phone" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <path d="M6.5 3.5h3l1.2 4.1-1.9 1.5a13 13 0 0 0 6.1 6.1l1.5-1.9 4.1 1.2v3c0 1.1-.9 2-2 2C10.5 19.5 4.5 13.5 4.5 5.5c0-1.1.9-2 2-2Z" />
                        </svg>
                      ) : channel.label === "GitHub" ? (
                        <svg viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 .1.1.97 2.02.72.1-.72.39-1.22.7-1.5-2.51-.29-5.15-1.26-5.15-5.6 0-1.24.44-2.26 1.16-3.06-.12-.28-.5-1.45.11-3.02 0 0 .95-.31 3.1 1.17a10.76 10.76 0 0 1 5.64 0c2.15-1.48 3.1-1.17 3.1-1.17.61 1.57.23 2.74.11 3.02.72.8 1.16 1.82 1.16 3.06 0 4.35-2.65 5.31-5.17 5.59.4.35.76 1.04.76 2.1v3.12c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
                        </svg>
                      ) : channel.label === "LinkedIn" ? (
                        <span class="contact-channel-icon-wordmark">in</span>
                      ) : (
                        <span class="contact-channel-icon-wordmark">up</span>
                      )}
                    </span>
                    <span class="contact-channel-label">{label}</span>
                    <span class="contact-channel-value">
                      {value}
                      {channel.label !== "Email" ? <span aria-hidden="true">↗</span> : null}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
