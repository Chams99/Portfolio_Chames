---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "@/astro/SiteFooter.astro";
import SiteHeader from "@/astro/SiteHeader.astro";
import { getCanonicalUrl, siteConfig } from "@/data/site";
import { getLocaleFromUrl } from "@/i18n/index";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  locale?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical = getCanonicalUrl(Astro.url.pathname),
  robots,
  locale = getLocaleFromUrl(Astro.url),
} = Astro.props;

const pageTitle = title
  ? title.includes(siteConfig.name)
    ? title
    : `${title} | ${siteConfig.name}`
  : siteConfig.title;
const htmlLang = locale === "fr" ? "fr" : "en";
const openGraphLocale = locale === "fr" ? "fr_FR" : siteConfig.locale;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0a0f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={getCanonicalUrl(siteConfig.ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={getCanonicalUrl(siteConfig.ogImage)} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href={getCanonicalUrl("/sitemap.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;0,6..96,800;1,6..96,400;1,6..96,700&family=DM+Sans:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${siteConfig.siteUrl}/#website`,
            url: siteConfig.siteUrl,
            name: siteConfig.name,
            description: siteConfig.description,
            publisher: { "@id": `${siteConfig.siteUrl}/#person` },
          },
          {
            "@type": "Person",
            "@id": `${siteConfig.siteUrl}/#person`,
            name: siteConfig.name,
            alternateName: "Chames Eddine",
            jobTitle: "Full-Stack Web & Mobile Developer",
            description: siteConfig.description,
            email: `mailto:${siteConfig.email}`,
            url: siteConfig.siteUrl,
            sameAs: [
              "https://github.com/Chams99",
              "https://www.linkedin.com/in/dhibi-chames-eddine-827146344/",
              "https://www.upwork.com/freelancers/~01ec2dc27e0c617399",
            ],
            address: {
              "@type": "PostalAddress",
              addressLocality: "Gafsa",
              addressCountry: "Tunisia",
            },
          },
        ],
      })}
    />
    <ClientRouter />
    <script is:inline>
      // Hide split-target headlines before first paint so SplitText can stage them.
      // Skipped when JS is off or motion is reduced, so text is never trapped hidden.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-split");
      }
    </script>
    <noscript>
      <style>
        [data-simplebar] {
          overflow: auto;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:border focus:border-white/10 focus:bg-black focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <div class="min-h-screen">
      <SiteHeader pathname={Astro.url.pathname.replace(/^\/fr/, '') || '/'} locale={locale} />
      <div id="main-content" tabindex="-1">
        <slot />
      </div>
      <SiteFooter locale={locale} />
    </div>

    <script>
      import "simplebar";
      import "@/scripts/scroll-reveal";
      import "@/scripts/type-reveal";
    </script>
  </body>
</html>
